{
    "name": "mapo-89/laravel-qr-decoder",
    "description": "A cross‑platform Laravel package for decoding QR codes from PNG images using Python",
    "keywords": [
        "mapo-89",
        "laravel-qr-decoder"
    ],
    "homepage": "https://github.com/mapo-89/laravel-qr-decoder",
    "license": "MIT",
    "type": "library",
    "authors": [
        {
            "name": "Manuel Postler",
            "email": "info@postler.de",
            "role": "Developer"
        }
    ],
    "require": {
        "php": "^8.2",
        "illuminate/support": "^12.0|^13.0",
        "spatie/laravel-package-tools": "^1.93.0",
        "symfony/process": "^7.4|^8.0"
    },
    "require-dev": {
        "larastan/larastan": "^3.10",
        "laravel/pint": "^1.27",
        "orchestra/testbench": "^10.0|^11.0",
        "phpunit/phpunit": "^11.0|^12.0|^13.0"
    },
    "autoload": {
        "psr-4": {
            "Mapo89\\QrDecoder\\": "src"
        }
    },
    "autoload-dev": {
        "psr-4": {
            "Mapo89\\QrDecoder\\Tests\\": "tests"
        }
    },
    "scripts": {
        "test": "vendor/bin/phpunit --bootstrap vendor/autoload.php tests",
        "test-coverage": "vendor/bin/phpunit --bootstrap vendor/autoload.php --coverage-html coverage tests",
        "check-style": "pint --test",
        "format": "pint",
        "analyse": "phpstan analyse --memory-limit=768M",
        "check-autoload": "@composer dump-autoload --optimize --strict-psr --no-scripts",
        "qa": [
            "@check-composer",
            "@check-autoload",
            "@check-style",
            "@analyse",
            "@test",
            "@check-python",
            "@test-python",
            "@composer audit"
        ],
        "check-python": [
            "@php .github/scripts/python.php -m ruff check python tests/fixtures",
            "@php .github/scripts/python.php -m ruff format --check python tests/fixtures"
        ],
        "format-python": [
            "@php .github/scripts/python.php -m ruff check --fix python tests/fixtures",
            "@php .github/scripts/python.php -m ruff format python tests/fixtures"
        ],
        "check-composer": "@composer validate --strict",
        "test-python": "@php .github/scripts/python.php -m unittest discover -s python -p 'test_*.py' -v"
    },
    "config": {
        "sort-packages": true
    },
    "extra": {
        "laravel": {
            "providers": [
                "Mapo89\\QrDecoder\\QrDecoderServiceProvider"
            ],
            "aliases": {
                "QrDecoder": "Mapo89\\QrDecoder\\QrDecoderFacade"
            }
        }
    }
}
